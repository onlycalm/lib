# Doxyfile for lib repository
# 用法：doxygen Doxyfile
# 文档输出：doc/html/index.html（模块文档见 Modules 页）

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Sta"
PROJECT_BRIEF          = "状态模块"

OUTPUT_DIRECTORY       = doc
OUTPUT_LANGUAGE        = Chinese

INPUT                  = .
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.md
EXCLUDE_PATTERNS       = */build/* */.cache/*

OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES

# 使 #ifdef COM_H / #ifdef LOG_H 包裹的 .c 实现能被提取
PREDEFINED             = COM_H STA_H STA_IMPL_H
INCLUDE_PATH           = ../com

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES

# 调用图需要 graphviz；未安装时保持 NO，安装后可改 YES 并开启 CALL_GRAPH/CALLER_GRAPH
HAVE_DOT               = NO
